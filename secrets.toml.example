# Copy to secrets.toml and fill in.
# secrets.toml is gitignored. The JUMABEK_API_KEY env var overrides [llm].api_key.

[llm]
api_key = ""

[voice]
groq_api_key = ""

# Per-skill secrets. Each section is handed only to the skill of that name,
# as JUMABEK_SKILL_<KEY> environment variables.
#
# [skills.weather]
# api_key = "..."

# Who may knock on the inbox. Each caller gets its own token, so one can be
# revoked without touching the others. At least 24 characters — generate, do
# not invent. Every name here needs a matching [inbox.grants.<name>] in
# config.toml saying what it is allowed to do.
[inbox.tokens]
# telegram = "..."
